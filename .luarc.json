{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "workspace.library": [
    "tools/types"
  ],
  "workspace.ignoreDir": [
    "Libs",
    "tools"
  ],
  "diagnostics.globals": [
    "ProffDB",
    "ProffDebugDB",
    "SLASH_PROFF1",
    "SlashCmdList"
  ],
  "diagnostics.disable": [
    "undefined-global",
    "need-check-nil",
    "cast-local-type",
    "assign-type-mismatch",
    "param-type-mismatch"
  ]
}
